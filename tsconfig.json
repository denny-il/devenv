{
  "compilerOptions": {
    "noEmit": true,

    "module": "nodenext",
    "target": "esnext",
    "lib": ["esnext"],
    "types": ["node"],

    "declaration": true,

    // The source runs as it is under Node's type stripping, and imports its
    // modules by their `.ts` names; the build rewrites those to `.js`.
    "erasableSyntaxOnly": true,
    "rewriteRelativeImportExtensions": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  },
  "include": ["src", "tests"]
}
